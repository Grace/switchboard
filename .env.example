# The environment the control plane and the sidecar read. Names only: every
# value here is empty on purpose, and nothing in this repository resolves them
# for you.
#
# This file used to hold CloudFormation dynamic references
# ({{resolve:secretsmanager:...}}) with a note to resolve them using `asm-exec`.
# No shell expands that syntax, and `asm-exec` is not a tool a reader has, so
# sourcing this file produced literal brace strings and a DSN parse error naming
# psycopg. See docs/DEPLOYMENT.md.
#
# How each value actually arrives:
#
#   On ECS      the task definition's `secrets:` block names a Secrets Manager
#               ARN per variable and the execution role fetches it at task
#               start. deploy/cloudformation/quickstart.yaml does this; specify
#               ARNs, never values.
#   Elsewhere   inject them from whatever secret store you run, by whatever
#               means keeps the value off a command line and out of shell
#               history. Do not paste them here.
#   Locally     `make dev-up` generates the whole set into .dev/env, which is
#               gitignored. See docs/LOCAL.md.

# Control plane
DATABASE_URL=
POLICY_SIGNING_SEED=
POLICY_KEY_ID=key-2026-09

# Sidecar. CONTROL_TOKEN authenticates the gateway to the control plane;
# LOCAL_TOKEN is what your application presents to the gateway.
CONTROL_TOKEN=
LOCAL_TOKEN=

# Providers. Only the ones your signed policy routes to, and every configured
# provider needs its key set even if the policy never selects it.
OPENAI_API_KEY=
ANTHROPIC_API_KEY=
GEMINI_API_KEY=
